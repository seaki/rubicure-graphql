# Gemfile for running this app on Ruby 3.1. It shares the gem list with the
# top-level Gemfile but keeps its own Gemfile.lock next to this file, because
# the top-level Gemfile.lock holds gem versions that no longer support Ruby 3.1.
#
#   BUNDLE_GEMFILE=gemfiles/ruby3.1/Gemfile bundle install
eval_gemfile "../../Gemfile"

ruby "~> 3.1.0"
